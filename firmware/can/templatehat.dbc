# IDs use extended 29-bit. Values here are decimal: 0x0707FFMM = 1179645MM

BO_ 117964579 TEMPLATE_Heartbeat: 4 TEMPLATEHAT
 SG_ node_id : 0|8@1+ (1,0) [0|255] "" TEMPLATEHAT
 SG_ alive   : 8|8@1+ (1,0) [0|255] "" TEMPLATEHAT
 SG_ ts_hi   : 16|8@1+ (1,0) [0|255] "" TEMPLATEHAT
